{
  // 共有サーバー。ログイン情報（API トークン等）はここに書かず、GitHub Secrets から渡す
  "name": "tournament",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tournament",
      "database_id": "26f095f8-b04d-4eb9-9b5c-09db79280e95"
    }
  ],
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
